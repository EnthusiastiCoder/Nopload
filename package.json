{
  "name": "nopload",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/copy-runtime-assets.mjs",
    "build": "astro build && node scripts/csp-hashes.mjs",
    "serve": "node scripts/serve-dist.mjs --port 4321",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "astro check && tsc --noEmit",
    "lint": "biome check src scripts",
    "licenses": "node scripts/check-licenses.mjs",
    "lighthouse": "npx lighthouse http://localhost:4321/ --form-factor=mobile --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=reports/lighthouse/home.json --chrome-flags=--headless=new"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vite-pwa/astro": "^2.0.4",
    "happy-dom": "^21.0.4",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "comlink": "^4.4.2",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5"
  }
}
