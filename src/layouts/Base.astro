---
// Page shell: head metadata (canonical, OG, JSON-LD), header with the tool nav and the
// shell island (privacy badge, theme, settings), footer. Exactly one <h1> comes from the page.
import '../styles/global.css';
import ShellIsland from '../components/ShellIsland';
import { mainTools } from '../tools/registry';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. "/" or "/privacy". */
  path: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://nopload.pages.dev');
const canonical = new URL(path, site).href;
const ogImage = new URL('/og/default.png', site).href;
const nav = mainTools();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline src="/theme.js"></script>
    <meta name="theme-color" content="#5b3df5" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nopload" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...data })} />)}
  </head>
  <body class="min-h-dvh bg-bg text-fg antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-surface focus:p-2">
      Skip to content
    </a>
    <header class="sticky top-0 z-30 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
        <a href="/" class="flex min-h-11 items-center gap-2 font-semibold tracking-tight" aria-label="Nopload home">
          <img src="/icons/favicon.svg" alt="" width="28" height="28" />
          <span class="text-lg">Nopload</span>
        </a>
        <nav aria-label="Tools" class="hidden lg:block">
          <ul class="flex items-center gap-1 text-sm">
            {
              nav.map((t) => (
                <li>
                  <a
                    href={`/${t.slug}`}
                    class:list={['rounded-md px-2.5 py-2 hover:bg-surface-2', path === `/${t.slug}` && 'bg-surface-2 font-medium']}
                    aria-current={path === `/${t.slug}` ? 'page' : undefined}
                  >
                    {t.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ShellIsland client:load />
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-muted">
        <p>Your images never leave your device. © Arpan Mandal</p>
        <nav aria-label="Site">
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {nav.map((t) => <li><a class="hover:text-fg underline-offset-4 hover:underline" href={`/${t.slug}`}>{t.name}</a></li>)}
            <li><a class="hover:text-fg underline-offset-4 hover:underline" href="/privacy">Privacy</a></li>
            <li><a class="hover:text-fg underline-offset-4 hover:underline" href="/about">About</a></li>
            <li><a class="hover:text-fg underline-offset-4 hover:underline" href="/about#notices">Open source notices</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
