---
// Tool page frame: h1 + subtitle, the tool island (slot), how-it-works strip, FAQ and related
// tools. Emits SoftwareApplication and FAQPage JSON-LD. A 'soon' tool shows a placeholder card.
import { Icon } from '../components/ui/Icon';
import { mainTools, type Tool } from '../tools/registry';
import Base from './Base.astro';

interface Props {
  tool: Tool;
  heading?: string;
  subtitle?: string;
  faq?: { q: string; a: string }[];
  /** Social card path; Base falls back to the default card. */
  ogImage?: string;
}

const { tool, heading = tool.name, subtitle = tool.blurb, faq = [], ogImage } = Astro.props;
const path = `/${tool.slug}`;
const site = Astro.site ?? new URL('https://nopload.pages.dev');
const baseId = tool.alias ?? tool.id;
const related = mainTools().filter((t) => t.id !== baseId);

const faqs = [
  ...faq,
  {
    q: 'Are my images uploaded anywhere?',
    a: 'No. Nopload processes every image inside your browser. Nothing is sent to a server, and the page is locked so it cannot contact any other site.',
  },
  { q: 'Is it free?', a: 'Yes. Free, no account, no watermark and no limits beyond what your device can handle.' },
  {
    q: 'Does it work offline?',
    a: 'Yes. After the first visit the app works without a connection. Use Settings to download the AI model ahead of time.',
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'SoftwareApplication',
    name: `Nopload ${tool.name}`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (runs in the browser)',
    url: new URL(path, site).href,
    description: tool.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const steps = [
  { icon: 'upload', title: 'Add images', text: 'Drop, paste or pick files. They are opened by your browser, not uploaded.' },
  { icon: 'cpu', title: 'Processed on your device', text: 'Everything runs locally, in WebAssembly and on your GPU when available.' },
  { icon: 'download', title: 'Download', text: 'Save one file or the whole batch as a ZIP, at full resolution.' },
];
---

<Base title={tool.title} description={tool.description} path={path} jsonLd={jsonLd} ogImage={ogImage}>
  <section class="mx-auto max-w-3xl text-center">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h1>
    <p class="mt-3 text-lg text-muted">{subtitle}</p>
  </section>

  <div class="mx-auto mt-8 max-w-4xl">
    {
      tool.status === 'soon' ? (
        <div class="rounded-xl border border-dashed border-line bg-surface p-8 text-center shadow-soft">
          <Icon name={tool.icon} size={32} class="mx-auto text-accent-600" />
          <p class="mt-3 text-lg font-semibold">Coming soon</p>
          <p class="mt-1 text-muted">This tool is being built. Every other tool on Nopload works the same way: in your browser, with no upload.</p>
          <a href="/" class="mt-4 inline-flex min-h-11 items-center rounded-md px-4 font-medium text-accent-700 underline underline-offset-4">
            Back to all tools
          </a>
        </div>
      ) : (
        <slot />
      )
    }
  </div>

  <section class="mx-auto mt-16 max-w-5xl" aria-labelledby="how">
    <h2 id="how" class="text-center text-2xl font-semibold">How it works, and why it is private</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="rounded-xl border border-line bg-surface p-5 shadow-soft">
            <Icon name={s.icon} size={22} class="text-accent-600" />
            <h3 class="mt-3 font-semibold">
              {i + 1}. {s.title}
            </h3>
            <p class="mt-1 text-sm text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="faq">
    <h2 id="faq" class="text-2xl font-semibold">Questions</h2>
    <div class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface">
      {
        faqs.map((f) => (
          <details class="group p-4">
            <summary class="cursor-pointer font-medium">{f.q}</summary>
            <p class="mt-2 text-sm text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-5xl" aria-labelledby="related">
    <h2 id="related" class="text-2xl font-semibold">More tools</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        related.map((t) => (
          <li>
            <a href={`/${t.slug}`} class="flex h-full items-start gap-3 rounded-xl border border-line bg-surface p-4 shadow-soft hover:bg-surface-2">
              <Icon name={t.icon} size={20} class="mt-0.5 text-accent-600" />
              <span>
                <span class="block font-medium">{t.name}</span>
                <span class="block text-sm text-muted">{t.blurb}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
