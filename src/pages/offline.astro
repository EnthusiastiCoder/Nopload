---
import Base from '../layouts/Base.astro';
---

<Base title="You are offline | Nopload" description="You are offline. Pages you have opened before still work." path="/offline" noindex>
  <section class="mx-auto max-w-xl py-16 text-center">
    <h1 class="text-3xl font-bold tracking-tight">You are offline</h1>
    <p class="mt-3 text-muted">This page has not been saved for offline use yet. Pages you have opened before still work.</p>
    <a href="/" class="mt-6 inline-flex min-h-11 items-center rounded-md bg-accent-600 px-5 font-medium text-white hover:bg-accent-700">Back to all tools</a>
  </section>
</Base>
