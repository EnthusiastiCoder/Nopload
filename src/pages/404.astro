---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Nopload" description="This page does not exist. Every Nopload tool is listed on the home page." path="/404" noindex>
  <section class="mx-auto max-w-xl py-16 text-center">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-muted">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="mt-6 inline-flex min-h-11 items-center rounded-md bg-accent-600 px-5 font-medium text-white hover:bg-accent-700">Back to all tools</a>
  </section>
</Base>
