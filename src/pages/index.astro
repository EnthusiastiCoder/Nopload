---
import HomeDrop from '../components/HomeDrop';
import { Icon } from '../components/ui/Icon';
import Base from '../layouts/Base.astro';
import { mainTools } from '../tools/registry';

const site = Astro.site ?? new URL('https://nopload.pages.dev');
const list = mainTools();
const chooser = list.map(({ slug, name, icon, blurb }) => ({ slug, name, icon, blurb }));
const jsonLd = [
  {
    '@type': 'WebSite',
    name: 'Nopload',
    url: site.href,
    description: 'Private image tools that run in your browser. Nothing is uploaded.',
  },
  {
    '@type': 'ItemList',
    itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: new URL(`/${t.slug}`, site).href })),
  },
];
const promises = [
  { icon: 'lock', title: 'Nothing is uploaded', text: 'Images are processed by your browser. The page cannot talk to any other site.' },
  { icon: 'zap', title: 'Fast and free', text: 'No account, no watermark, no queue. Batch as many files as your device handles.' },
  { icon: 'wifi-off', title: 'Works offline', text: 'Install it as an app and keep using it without a connection.' },
];
---

<Base
  title="Nopload: Private Image Tools That Never Upload"
  description="Remove backgrounds, compress, convert, resize and strip EXIF from images in your browser. Free, no signup, and your photos never leave your device."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero-glow relative mx-auto max-w-3xl text-center">
    <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">Edit images without uploading them</h1>
    <p class="mt-4 text-lg text-muted text-balance">
      Background remover, compressor, converter and more. Everything runs on your device, so your photos stay yours.
    </p>
  </section>

  <div class="mx-auto mt-8 max-w-3xl">
    <HomeDrop client:load tools={chooser} />
  </div>

  <section class="mt-16" aria-labelledby="tools">
    <h2 id="tools" class="text-2xl font-semibold">All tools</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        list.map((t) => (
          <li>
            <a
              href={`/${t.slug}`}
              class="group flex h-full flex-col rounded-xl border border-line bg-surface p-5 shadow-soft transition-shadow hover:shadow-lift"
            >
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-accent-50 text-accent-700">
                <Icon name={t.icon} size={22} />
              </span>
              <span class="mt-3 flex items-center gap-2 font-semibold">
                {t.name}
                {t.status === 'soon' && <span class="rounded-full bg-surface-2 px-2 py-0.5 text-xs font-medium text-muted">Soon</span>}
              </span>
              <span class="mt-1 text-sm text-muted">{t.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 grid gap-4 sm:grid-cols-3" aria-label="Why Nopload">
    {
      promises.map((p) => (
        <div class="rounded-xl border border-line bg-surface p-5">
          <Icon name={p.icon} size={22} class="text-mint-600" />
          <h2 class="mt-3 font-semibold">{p.title}</h2>
          <p class="mt-1 text-sm text-muted">{p.text}</p>
        </div>
      ))
    }
  </section>
</Base>
