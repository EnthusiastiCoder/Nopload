# Normalize text files to LF in the repo and the working tree, regardless of core.autocrlf.
* text=auto eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.jxl binary
*.heic binary
*.heif binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary

# WebAssembly and models
*.wasm binary
*.onnx binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
